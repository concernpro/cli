{
  "name": "concern-cli",
  "version": "0.1.0",
  "description": "Hire Concern's engineers and verifiers from your terminal.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/concernpro/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concernpro/cli.git"
  },
  "keywords": [
    "concern",
    "hire",
    "engineers",
    "cli",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "concern": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "concern": "node src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
